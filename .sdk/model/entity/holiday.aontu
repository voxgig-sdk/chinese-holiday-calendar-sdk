# Entity: holiday

main: kit: entity: holiday: {

  alias: field: {}

  fields: {
    date: {
      fo: "date"
      h: "Date"
      n: "date"
      r: true
      sh: "The date of the holiday in YYYY-MM-DD format"
      t: "`$STRING`"
    }
    isOffDay: {
      h: "Is Off Day"
      n: "isOffDay"
      r: true
      sh: "Whether this is an official day off (true) or a working day during a holiday period (false)"
      t: "`$BOOLEAN`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the holiday in Chinese"
      t: "`$STRING`"
    }
  }

  name: "holiday"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /holidays/{year}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: 2024
                k: "param"
                n: "year"
                or: "year"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/holidays/{year}"
          q: {
            exist: [
              "year"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "holidays"
            }
            {
              var: "year"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
