# Entity: holiday

main: kit: entity: holiday: {

  alias: field: {}

  fields: [
    {
      format: "date"
      name: "date"
      req: true
      short: "The date of the holiday in YYYY-MM-DD format"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "isOffDay"
      req: true
      short: "Whether this is an official day off (true) or a working day during a holiday period (false)"
      type: "`$BOOLEAN`"
    }
    {
      name: "name"
      req: true
      short: "The name of the holiday in Chinese"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "holiday"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 2024
                kind: "param"
                name: "id"
                orig: "year"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /holidays/{year}"
            json: "{\"operationId\":\"getHolidaysByYear\",\"parameters\":[{\"description\":\"The year for which to retrieve holidays (e.g., 2024)\",\"in\":\"path\",\"name\":\"year\",\"required\":true,\"schema\":{\"example\":2024,\"maximum\":2100,\"minimum\":2000,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":{\"properties\":{\"date\":{\"description\":\"The date of the holiday in YYYY-MM-DD format\",\"example\":\"2024-01-01\",\"format\":\"date\",\"type\":\"string\"},\"isOffDay\":{\"description\":\"Whether this is an official day off (true) or a working day during a holiday period (false)\",\"example\":true,\"type\":\"boolean\"},\"name\":{\"description\":\"The name of the holiday in Chinese\",\"example\":\"元旦\",\"type\":\"string\"}},\"required\":[\"date\",\"name\",\"isOffDay\"],\"type\":\"object\"},\"example\":{\"2024-01-01\":{\"date\":\"2024-01-01\",\"isOffDay\":true,\"name\":\"元旦\"},\"2024-02-10\":{\"date\":\"2024-02-10\",\"isOffDay\":true,\"name\":\"春节\"},\"2024-04-04\":{\"date\":\"2024-04-04\",\"isOffDay\":true,\"name\":\"清明节\"}},\"type\":\"object\"}}},\"description\":\"Successful response with holiday data\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"integer\"},\"error\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Year not found or no data available\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"integer\"},\"error\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/holidays/{year}"
          rename: {
            param: {
              year: "id"
            }
          }
          segments: [
            {
              lit: "holidays"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
